# PiHoleVault Environment Configuration
# Copy this file to .env and modify as needed

# Discord Webhook URL for notifications (optional)
# Get this from your Discord server: Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Node.js Environment
NODE_ENV=production

# Data directories
DATA_DIR=/app/data
BACKUP_DIR=/app/backups

# Debug Configuration
# Set DEBUG_MODE=true to enable comprehensive debugging features
DEBUG_MODE=false

# Logging levels: error, warn, info, debug
# LOG_LEVEL controls general application logging
LOG_LEVEL=info

# DEBUG_LEVEL controls debug service logging (only used when DEBUG_MODE=true)
DEBUG_LEVEL=debug

# ====== SECURITY ======

# API authentication token (STRONGLY RECOMMENDED).
#
# When set, every /api request must present it as either
#   Authorization: Bearer <token>
# or
#   X-Auth-Token: <token>
# and the web UI will prompt for it once and remember it in the browser.
#
# When left unset the API is UNAUTHENTICATED: anyone who can reach the port can
# read the configuration, download backups and open SSH connections. Only leave
# it unset on a host that nothing untrusted can reach.
#
# Generate one with:  openssl rand -hex 32
# AUTH_TOKEN=

# Comma-separated list of origins allowed to call the API from a browser.
# Leave unset unless the UI is served from a different origin than the API.
# Previously the server sent Access-Control-Allow-Origin: * to every caller.
# CORS_ALLOWED_ORIGINS=https://piholevault.example.com

# SSH host key policy:
#   tofu     (default) pin the key the first time a host is seen, refuse changes
#   strict   only connect to hosts already pinned in data/known_hosts.json
#   insecure accept any host key -- vulnerable to man-in-the-middle
# SSH_HOST_KEY_POLICY=tofu

# Re-enable SSH algorithms that are disabled by default (ssh-rsa, ssh-dss,
# hmac-sha1). Only needed for Pi-hole hosts running very old OpenSSH versions.
# SSH_ALLOW_LEGACY_ALGORITHMS=false

# Skip TLS certificate verification when talking to the Pi-hole web API.
# Needed only when the Pi-hole serves HTTPS with a self-signed certificate;
# it exposes the Pi-hole admin password to an on-path attacker.
# ALLOW_INSECURE_TLS=false

# Rate limits, per 15 minute window per client IP.
# RATE_LIMIT_MAX=600
# RATE_LIMIT_SENSITIVE_MAX=30

# Which proxy hops to trust for the client IP. The bundled image puts nginx on
# loopback in front of the backend, so the default is correct there.
# TRUST_PROXY=loopback

# ====== DEBUG MODE USAGE ======
# To enable debug mode, set:
# DEBUG_MODE=true
# LOG_LEVEL=debug
# DEBUG_LEVEL=debug
#
# Debug mode provides:
# - Detailed logging with stack traces
# - Debug API endpoints at /api/debug/*
# - Enhanced error reporting
# - System information collection
# - SSH connectivity testing
# - Log analysis tools
#
# Available debug endpoints when DEBUG_MODE=true:
# - http://localhost:3000/api/debug/status
# - http://localhost:3000/api/debug/system-info
# - http://localhost:3000/api/debug/health-check
# - http://localhost:3000/api/debug/logs
# - http://localhost:3000/api/debug/log-analysis
# - http://localhost:3000/api/debug/report
# - http://localhost:3000/api/debug/files
# - http://localhost:3000/api/debug/test-ssh
# - http://localhost:3000/api/debug/environment
# ==============================
